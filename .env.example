PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=your-firebase-project-id
# Set GOOGLE_APPLICATION_CREDENTIALS to the path of your service-account JSON
# file on the server. Never commit that JSON file or put it in a Flutter app.
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
PAIRING_CODE_TTL_MINUTES=10
LOCATION_REQUEST_COOLDOWN_SECONDS=30
